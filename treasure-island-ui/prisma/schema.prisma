generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String  @id
  email      String  @unique
  password   String
  name       String
  role       String  @default("USER")
  is_active  Boolean @default(true)
  created_at String

  @@map("users")
}

// Singleton row (id = "default") for global admin settings.
// `*_model` fields are Model.id values (not enforced as FK — allows loose
// coupling so deleting a Model row doesn't cascade into the config).
model AppConfig {
  id                   String @id @default("default")
  // Legacy — kept for backward compat, maps to active_video_model.
  video_model          String @default("ltx2-distilled")
  // Per-category active selections (FK to Model.id by convention).
  active_image_model   String @default("flux-schnell")
  active_video_model   String @default("ltx2-distilled")
  active_tts_model     String @default("xtts-v2")
  active_content_model String @default("qwen2.5-7b")
  updated_at           String

  @@map("app_config")
}

// Catalog of models the platform knows how to run.
// Rows are seeded and admin-editable. The `workflow_id` column is the key
// that the runtime registry (src/lib/workflows/index.ts) uses to look up the
// builder function. The `install_script` is pasted into the pod-setup.sh at
// provision time when a pod opts into this model.
model Model {
  id              String  @id                   // stable slug, e.g. "ltx2-distilled"
  category        String                        // "image" | "video" | "tts" | "content"
  label           String                        // human-readable display name
  description     String  @default("")
  workflow_id     String                        // key in WORKFLOWS registry
  install_script  String  @default("")          // bash that downloads weights / installs nodes
  default_params  Json    @default("{}")        // {steps, cfg, width, height, frames, ...}
  vram_gb         Int     @default(16)
  disk_gb         Int     @default(10)
  is_enabled      Boolean @default(true)        // false = hidden from selection UIs
  is_default      Boolean @default(false)       // initial pick in pod-create wizard for its category
  // Optional host URL for health probing — admin points this at a specific
  // pod's proxy (e.g. ComfyUI for image/video, Ollama for content, Flask for
  // tts) and the catalog Test button checks whether that pod actually has
  // the model installed + serving. Leaving this empty uses the category's
  // global active host at test time.
  host            String  @default("")
  created_at      String

  @@index([category, is_enabled])
  @@map("models")
}

// Admin-managed API keys and shared secrets. Name is the env-var-style key
// (e.g. "HF_TOKEN", "RUNPOD_API_KEY"); value is stored as plaintext since DB
// access is already SUPERADMIN-gated. Callers should go through
// `lib/secrets.ts:getSecret()` which prefers this row then falls back to
// `process.env[name]` so legacy deployments continue to work unchanged.
model AppSecret {
  name        String @id
  value       String
  description String @default("")
  updated_at  String

  @@map("app_secrets")
}

// Tracks which catalog Model.id values were selected for each RunPod pod
// at creation time. RunPod itself stores the INSTALL_* env flags but not the
// original model-id list, so we persist it locally to render "which models
// are on this pod" in the admin UI. Removed on pod delete.
model PodModel {
  pod_id     String   @id
  model_ids  String[]
  created_at String

  @@map("pod_models")
}

model Project {
  id                   String  @id
  name                 String
  style_guide          String?
  style_guide_filename String?
  storyboard_filename  String?
  status               String
  created_at           String
  base_image_path      String?
  base_image_comfyui   String?
  base_image_prompt    String?
  base_image_seed      Int?
  pipeline_model       String?
  user_id              String?

  @@map("projects")
}

model Episode {
  id         String  @id
  project_id String
  number     Int
  title      String
  summary    String?
  created_at String

  @@map("episodes")
}

model Shot {
  id               String   @id
  episode_id       String
  project_id       String
  shot_number      Int
  character        String?
  location_id      String?
  shot_description String
  environment      String
  lighting         String
  camera_angle     String
  full_prompt      String
  negative_prompt  String
  seed             Int?
  width            Int
  height           Int
  steps            Int
  status           String
  approved_image_id  String?
  approved_image_ids String[]
  approved_video_id  String?
  approved_tts_id    String?
  created_at         String
  story_line         String?
  dialogue           String?
  anchor             String?
  audio_path         String?
  video_audio_path   String?
  pipeline_model     String?
  prompt_template_id String?
  interaction_type   String?

  @@map("shots")
}

model PromptTemplate {
  id         String  @id
  project_id String
  name       String
  formula    String
  is_default Boolean @default(false)
  created_at String

  @@map("prompt_templates")
}

// shot_id can reference shot.id, character.id, or "base_{projectId}"
model Generation {
  id                String  @id
  shot_id           String
  type              String
  comfyui_prompt_id String?
  status            String
  seed              Int?
  image_path        String?
  video_path        String?
  audio_path        String?
  voice             String?
  error             String?
  ref_image         String?
  created_at        String
  completed_at      String?

  @@map("generations")
}

model Character {
  id               String  @id
  project_id       String
  name             String
  description      String
  appearance       String
  role             String
  reference_prompt String
  reference_image  String?
  seed             Int?
  status           String
  created_at       String
  pipeline_model   String?

  @@map("characters")
}

// Reusable environment/set (ship deck, inn interior, island shore, etc).
// Acts as a "location brick" — description is injected into shot prompts;
// reference_image is used as a second IP-Adapter input at generation time
// to keep backgrounds visually consistent across shots in the same location.
model Location {
  id              String  @id
  project_id      String
  name            String
  description     String
  reference_image String?
  created_at      String

  @@map("locations")
}

model Frame {
  id           String  @id
  shot_id      String
  frame_number Int
  description  String
  prompt       String  @default("")
  needed       Boolean @default(true)
  image_path   String?
  video_path   String?
  status       String  @default("draft")
  ai_suggested Boolean @default(false)
  created_at   String

  @@map("frames")
}

model PromptSettings {
  id                    String   @id
  project_id            String   @unique
  content_provider      Json
  image_provider        Json
  video_provider        Json
  openai_api_key        String
  anthropic_api_key     String
  ollama_host           String
  comfyui_host          String
  mode                  String
  art_style             String
  quality_tags          String
  negative_prompt       String
  environment_preset    String
  lighting_preset       String
  camera_presets        String[]
  color_palette         String
  custom_prefix         String
  custom_suffix         String
  video_prompt_template String
  tts_default_voice     String
  tts_character_voices  Json
  tts_speed             Float
  created_at            String

  @@map("prompt_settings")
}
